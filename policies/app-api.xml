<!--
  Política da API da aplicação.

  Regra: TODA rota exige JWT válido, exceto duas que não podem exigir:
    - POST /api/v1/Autenticacao/login  (login do funcionário — quem chama ainda não tem token)
    - /health                          (probe do Datadog synthetics e do AKS)

  Isso inclui, de propósito, as rotas que na Fase 2 eram [AllowAnonymous]
  (consulta pública de status de OS e resposta de orçamento). Na Fase 3 elas
  passam a exigir o token de cliente emitido pela Auth Function a partir do CPF.

  O mesmo validate-jwt aceita tanto o token de funcionário (emitido pela API)
  quanto o de cliente (emitido pela Function): ambos são assinados com o mesmo
  segredo HMAC e carregam o mesmo issuer/audience.

  NOTA DE SINTAXE: expressões C# dentro de atributos XML precisam de &quot;
  para as aspas internas. Usar aspas duplas cruas encerra o atributo e o APIM
  rejeita a política com "is an unexpected token. Expecting white space."
-->
<policies>
  <inbound>
    <base />

    <!-- O <cors> vem ANTES do rate limit de proposito.
         Ele e quem responde ao preflight e encerra o pipeline ali. Com o rate
         limit na frente, cada chamada do navegador custava DUAS: o OPTIONS do
         preflight e o metodo de verdade. Como o painel manda X-Correlation-ID
         e Content-Type: application/json, todo POST gera preflight — o limite
         valia pela metade sem ninguem ver. -->
    <cors allow-credentials="false">
      <allowed-origins>
        <origin>*</origin>
      </allowed-origins>
      <allowed-methods>
        <method>GET</method>
        <method>POST</method>
        <method>PUT</method>
        <method>PATCH</method>
        <method>DELETE</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>*</header>
      </allowed-headers>
    </cors>

    <!-- Correlação: reaproveita o ID recebido ou gera um novo, e propaga para o backend. -->
    <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;, Guid.NewGuid().ToString()))" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>

    <choose>
      <!-- Rotas públicas seguem sem validação de token. A condição é negada
           aqui para que o bloco protegido fique no <when>, evitando um <when>
           vazio, que o APIM tambem rejeita. -->
      <when condition="@(!context.Request.Url.Path.ToLower().Contains(&quot;/autenticacao/login&quot;) &amp;&amp; !context.Request.Url.Path.ToLower().Contains(&quot;/health&quot;))">
        <validate-jwt header-name="Authorization"
                      failed-validation-httpcode="401"
                      failed-validation-error-message="Token inválido ou ausente."
                      require-expiration-time="true"
                      require-signed-tokens="true">
          <!-- A ordem dos filhos é fixa no schema do APIM:
               issuer-signing-keys, decryption-keys, audiences, issuers,
               required-claims. Inverter audiences e issuers faz o APIM
               rejeitar com "invalid child element". -->
          <issuer-signing-keys>
            <key>{{jwt-signing-key}}</key>
          </issuer-signing-keys>
          <audiences>
            <audience>PosTechChallenge-API</audience>
          </audiences>
          <issuers>
            <issuer>PosTechChallenge</issuer>
          </issuers>
        </validate-jwt>
      </when>
    </choose>
    <!-- Protecao contra abuso, por IP de origem. O contador leva o nome da API
         no prefixo para nao dividir balde com a politica de autenticacao. -->
    <rate-limit-by-key calls="120"
                       renewal-period="60"
                       counter-key="@(&quot;app-&quot; + context.Request.IpAddress)"
                       remaining-calls-header-name="X-RateLimit-Remaining"
                       retry-after-header-name="Retry-After" />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <!-- Devolve o ID de correlação para o cliente conseguir citá-lo num suporte. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
  </on-error>
</policies>
