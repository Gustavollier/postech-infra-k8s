<!--
  Política da API de autenticação (backend = Azure Function).

  Esta rota é pública por definição: quem chama ainda não possui token. A proteção
  aqui é rate limit agressivo, já que o endpoint recebe CPF e, sem limite, viraria
  um vetor de enumeração de clientes.
-->
<!--
  NOTA DE SINTAXE: expressões C# dentro de atributos XML precisam de &quot;
  para as aspas internas. Aspas duplas cruas encerram o atributo e o APIM
  rejeita a política com "is an unexpected token. Expecting white space."
-->
<policies>
  <inbound>
    <base />

    <!-- O <cors> vem ANTES do rate limit de proposito.
         Ele e quem responde ao preflight e encerra o pipeline ali. Com o rate
         limit na frente, cada chamada do navegador custava DUAS: o OPTIONS do
         preflight e o metodo de verdade. Como o painel manda X-Correlation-ID
         e Content-Type: application/json, todo POST gera preflight — o limite
         valia pela metade sem ninguem ver. -->
    <cors allow-credentials="false">
      <allowed-origins>
        <origin>*</origin>
      </allowed-origins>
      <allowed-methods>
        <method>POST</method>
        <method>GET</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>*</header>
      </allowed-headers>
    </cors>

    <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;, Guid.NewGuid().ToString()))" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>

    <!-- A Function serve o POST em /api/auth, mas a operação do gateway mora na
         raiz desta API (/auth) com url_template "/". Sem reescrita, o caminho
         encaminhado ao backend vira /api/ e o host de Functions devolve 404 com
         corpo vazio — nenhuma função casa com aquela rota.

         O /health não precisa disso: url_template "/health" já cai em
         /api/health, que é onde a Function o expõe. -->
    <choose>
      <when condition="@(context.Operation.Id == &quot;auth-cpf&quot;)">
        <rewrite-uri template="/auth" />
      </when>
    </choose>

    <!-- Bem mais restritivo que a API principal, que permite 120: 30 tentativas
         por minuto por IP. O contador leva o nome da API no prefixo para nao
         dividir balde com a outra politica, que usa o mesmo IP como chave.
         30 ainda barra enumeracao de CPF, que e o ponto: varrer o espaco de
         CPFs a 30 por minuto e inviavel, e o 429 aparece muito antes. -->
    <rate-limit-by-key calls="30"
                       renewal-period="60"
                       counter-key="@(&quot;auth-&quot; + context.Request.IpAddress)"
                       remaining-calls-header-name="X-RateLimit-Remaining"
                       retry-after-header-name="Retry-After" />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
  </on-error>
</policies>
