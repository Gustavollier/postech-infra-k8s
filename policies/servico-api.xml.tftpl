<!--
  Política de cada microsserviço no APIM (os, billing, execucao, identidade).
  Gerada a partir deste template, com o que muda de um serviço para o outro:

    - as rotas públicas, que não exigem token. Cada serviço tem as suas:
      /health em todos (probe do Datadog synthetics); o login e a troca de
      senha no Identidade (quem chama ainda não tem token); o webhook no
      Billing (quem chama é o Mercado Pago).
    - o prefixo do contador de rate limit, para cada API ter o seu balde.

  O validate-jwt aceita o token de funcionário (emitido pelo Identidade) e o de
  cliente (emitido pela Auth Function): os dois são assinados com o mesmo
  segredo HMAC e carregam o mesmo issuer e audience.

  NOTA DE SINTAXE: expressões C# dentro de atributos XML precisam de &quot;
  para as aspas internas.
-->
<policies>
  <inbound>
    <base />
    <!-- O <cors> vem ANTES do rate limit de proposito: ele responde ao
         preflight e encerra o pipeline ali. Com o rate limit na frente, cada
         chamada do navegador custaria duas. -->
    <cors allow-credentials="false">
      <allowed-origins>
        <origin>*</origin>
      </allowed-origins>
      <allowed-methods>
        <method>GET</method>
        <method>POST</method>
        <method>PUT</method>
        <method>PATCH</method>
        <method>DELETE</method>
        <method>OPTIONS</method>
      </allowed-methods>
      <allowed-headers>
        <header>*</header>
      </allowed-headers>
    </cors>
    <!-- Correlação: reaproveita o ID recebido ou gera um novo, e propaga para
         o backend. É ele que amarra os logs dos quatro serviços e os eventos
         da saga num rastro só. -->
    <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault(&quot;X-Correlation-ID&quot;, Guid.NewGuid().ToString()))" />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
    <choose>
      <!-- A condição é negada para o bloco protegido ficar no <when>: um
           <when> vazio o APIM rejeita. -->
      <when condition="@(${join(" &amp;&amp; ", [for rota in publicas : "!context.Request.Url.Path.ToLower().Contains(&quot;${rota}&quot;)"])})">
        <validate-jwt header-name="Authorization"
                      failed-validation-httpcode="401"
                      failed-validation-error-message="Token inválido ou ausente."
                      require-expiration-time="true"
                      require-signed-tokens="true">
          <!-- A ordem dos filhos é fixa no schema do APIM: issuer-signing-keys,
               decryption-keys, audiences, issuers, required-claims. -->
          <issuer-signing-keys>
            <key>{{jwt-signing-key}}</key>
          </issuer-signing-keys>
          <audiences>
            <audience>PosTechChallenge-API</audience>
          </audiences>
          <issuers>
            <issuer>PosTechChallenge</issuer>
          </issuers>
        </validate-jwt>
      </when>
    </choose>
%{ if limitar ~}
    <!-- Proteção contra abuso, por IP de origem, com um balde por API.
         Só fora do tier Consumption, que não tem rate-limit-by-key. -->
    <rate-limit-by-key calls="120"
                       renewal-period="60"
                       counter-key="@(&quot;${prefixo}-&quot; + context.Request.IpAddress)"
                       remaining-calls-header-name="X-RateLimit-Remaining"
                       retry-after-header-name="Retry-After" />
%{ endif ~}
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <!-- Devolve o ID de correlação para o cliente conseguir citá-lo num suporte. -->
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
  </outbound>
  <on-error>
    <base />
    <set-header name="X-Correlation-ID" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault&lt;string&gt;("correlationId", ""))</value>
    </set-header>
  </on-error>
</policies>
